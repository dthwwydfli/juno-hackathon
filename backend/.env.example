DMD_DB_PATH=./data/dmd.sqlite
APP_DB_PATH=./data/app.sqlite
TRUD_API_KEY=
TRUD_DMD_ITEM_ID=
OPENFDA_API_KEY=
MEDDATA_API_KEY=
MEDDATA_BASE_URL=https://meddata.anthesia.io
# MedData is metered (250 requests/month on the current plan). Responses are
# cached by cabinet fingerprint for this long, so repeat checks cost nothing.
MEDDATA_CACHE_TTL_HOURS=24
# After a 429, skip MedData entirely for this long instead of retrying into the wall.
MEDDATA_QUOTA_COOLDOWN_HOURS=6
GP_TOKEN_TTL_HOURS=48
# Use your LAN IP when testing from a phone (same as VITE_PUBLIC_PDF_ORIGIN in frontend)
PUBLIC_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000
