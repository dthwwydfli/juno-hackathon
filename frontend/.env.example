# Same-machine dev (default)
VITE_API_BASE_URL=http://localhost:8000
VITE_USER_ID=demo
# Leave empty to use the same origin as VITE_API_BASE_URL for QR/PDF links
VITE_PUBLIC_PDF_ORIGIN=

# Deploy / Add to Home Screen (PWA):
# - Vercel: set Root Directory to `frontend`, add env vars below, deploy (see docs/deploy-vercel-phone-scan.md).
# - Set VITE_API_BASE_URL and VITE_PUBLIC_PDF_ORIGIN to a URL your phone can reach (tunnel or LAN IP — not localhost).
# - Backend: uvicorn --host 0.0.0.0 --port 8000; CORS_ORIGINS must include https://your-app.vercel.app
# - After deploy, smoke-test standalone: safe areas, bottom nav, forms (no iOS focus zoom).

# Optional: phone on Wi‑Fi dev — set both VITE_* URLs to your laptop LAN IP; add http://<LAN-IP>:5173 to backend CORS_ORIGINS
