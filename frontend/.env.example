# Same-machine dev (default)
VITE_API_BASE_URL=http://localhost:8000
VITE_USER_ID=demo
# Direct API URL for downloading GP PDFs from the patient app (optional; defaults to VITE_API_BASE_URL)
VITE_PUBLIC_PDF_ORIGIN=
# GP QR / share links: defaults to window.location.origin on the deployed app.
# Set to https://pocketary.vercel.app when generating QR from local `npm run dev` for phone scans.
VITE_PUBLIC_APP_ORIGIN=

# Deploy / Add to Home Screen (PWA):
# - Vercel: set Root Directory to `frontend`, add env vars below, deploy (see docs/deploy-vercel-phone-scan.md).
# - Set VITE_API_BASE_URL to a URL your phone can reach (HTTPS tunnel — not localhost).
# - GP QR encodes https://your-app.vercel.app/gp/<token> (/?gp=<token> is a legacy fallback).
# - Backend: uvicorn --host 0.0.0.0 --port 8000; CORS_ORIGINS must include https://your-app.vercel.app
# - After deploy, smoke-test standalone: safe areas, bottom nav, forms (no iOS focus zoom).

# Optional: phone on Wi‑Fi dev — set VITE_API_BASE_URL to your laptop LAN IP; add http://<LAN-IP>:5173 to backend CORS_ORIGINS
